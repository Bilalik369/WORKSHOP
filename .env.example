# Copiez ce fichier en .env.local puis renseignez les valeurs.
# Ne commitez jamais .env.local.

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Clé secrète : côté serveur uniquement. Ne la partagez jamais.
SUPABASE_SECRET_KEY=sb_secret_xxx

# --- Site ---
# URL publique du site, sans barre oblique finale (ex. https://workshop-ia.vercel.app)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Adresse de contact affichée sur le site et utilisée comme « reply-to »
NEXT_PUBLIC_CONTACT_EMAIL=contact@example.com

# --- Événement ---
# Nombre total de places (150 par défaut)
EVENT_CAPACITY=150
# Date limite de dépôt des projets (format ISO 8601, heure du Maroc = +01:00)
PROJECT_SUBMISSION_DEADLINE=2026-12-20T23:59:59+01:00

# --- Administration ---
# Adresses autorisées à accéder à /admin, séparées par des virgules
ADMIN_EMAILS=prenom.nom@example.com,autre.admin@example.com

# --- E-mails (Gmail, via SMTP) ---
# Adresse Gmail qui envoie les e-mails du site
GMAIL_USER=votre.adresse@gmail.com
# Mot de passe d'application Google (16 caractères) — PAS le mot de passe du compte.
# Création : https://myaccount.google.com/apppasswords (validation en deux étapes requise)
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx
